---
/**
 * Header of design v3: the owl mark and the wordmark, the menu, the language switch and a small search link.
 * At 1180 px and below the menu drops to a second row that scrolls sideways (CSS only, no script).
 */
import { LANGS, LANG_NAME, firm, type Lang } from '@/config/site';
import { t, localePath } from '@/i18n/utils';

interface Props { lang: Lang; section?: string; alternates: Partial<Record<Lang, string>> }
const { lang, section, alternates } = Astro.props;
const tr = t(lang);
const items = [
  { key: 'services', href: localePath(lang, 'services'), label: tr('nav.services') },
  { key: 'about', href: localePath(lang, 'about'), label: tr('nav.about') },
  { key: 'team', href: localePath(lang, 'team'), label: tr('nav.team') },
  { key: 'blog', href: localePath(lang, 'blog'), label: tr('nav.blog') },
  { key: 'documents', href: localePath(lang, 'documents'), label: tr('nav.documents') },
  { key: 'contacts', href: localePath(lang, 'contacts'), label: tr('nav.contacts') },
];
---
<header class="site-header">
  <div class="wrap hdr">
    <a class="brand" href={localePath(lang)} aria-label={`${firm.shortName} — ${tr('nav.home')}`}>
      <img src="/img/owls.svg" alt="" width="88" height="44" />
      <span class="wordmark">{firm.shortName}</span>
    </a>
    <nav class="mainnav" aria-label={tr('nav.menu')}>
      <ul class="nav">
        {items.map((i) => <li><a href={i.href} aria-current={section === i.key ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>
    <nav class="lang" aria-label={tr('nav.lang')}>
      {LANGS.map((l) =>
        alternates[l]
          ? <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={LANG_NAME[l]}>{l.toUpperCase()}</a>
          : <span title={tr('blog.unavailable')} aria-disabled="true">{l.toUpperCase()}</span>
      )}
      <a class="search-link" href={localePath(lang, 'search')} aria-label={tr('nav.search')} aria-current={section === 'search' ? 'page' : undefined}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m20.5 20.5-4.5-4.5"/></svg>
      </a>
    </nav>
  </div>
</header>
