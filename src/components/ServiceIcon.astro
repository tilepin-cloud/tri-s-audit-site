---
/** Stroke icons of the service cards (design v3), one per service key. 24-unit grid, 1.5 px stroke, no fill. */
interface Props { name: string }
const ICONS: Record<string, string> = {
  audit: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M9.5 15l2 2 3.5-4"/>',
  review: '<circle cx="11" cy="11" r="6.5"/><path d="M20.5 20.5 16 16"/><path d="M8.5 11h5M11 8.5v5"/>',
  'agreed-upon-procedures': '<rect x="5.5" y="4" width="13" height="17" rx="2"/><path d="M9 4V2.5h6V4"/><path d="M9 10h6M9 14h6M9 18h3"/>',
  compilation: '<path d="M4 7l8-4 8 4-8 4z"/><path d="M4 12l8 4 8-4"/><path d="M4 17l8 4 8-4"/>',
  assurance: '<circle cx="12" cy="9" r="5.5"/><path d="M9 14l-1.5 7L12 18.5 16.5 21 15 14"/>',
  ifrs: '<path d="M4 8h15"/><path d="M15.5 4.5 19 8l-3.5 3.5"/><path d="M20 16H5"/><path d="M8.5 12.5 5 16l3.5 3.5"/>',
  tax: '<path d="M12 3v18"/><path d="M5 7h14"/><path d="M5 7l-3 7a3 3 0 0 0 6 0z"/><path d="M19 7l-3 7a3 3 0 0 0 6 0z"/><path d="M9 21h6"/>',
  'it-report': '<path d="M12 3l8 3v6c0 4.8-3.4 8.2-8 9.5C7.4 20.2 4 16.8 4 12V6z"/><path d="M9 12l2 2 4-4"/>',
  forensic: '<circle cx="10" cy="10" r="6.5"/><path d="M20.5 20.5 15 15"/><path d="M7 10a3 3 0 0 1 6 0"/><circle cx="10" cy="10" r="1"/>',
};
const { name } = Astro.props;
const paths = ICONS[name] ?? ICONS.audit;
---
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={paths} />
