---
import type { MarkdownHeading } from 'astro';
import type { Lang } from '@/config/site';
import { t } from '@/i18n/utils';
interface Props { headings: MarkdownHeading[]; lang: Lang; title?: string }
const { headings, lang, title } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 1 && (
  <nav class="toc" aria-label={title ?? t(lang)('blog.toc')}>
    <h2>{title ?? t(lang)('blog.toc')}</h2>
    <ul>
      {items.map((h) => <li class={h.depth === 3 ? 'd3' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ul>
  </nav>
)}
