---
/**
 * Footer of design v3: four columns on near-black — the firm (white owl mark, wordmark, legal name, registry),
 * the sections, the services shown on the home page, and the contacts — then a bottom row with the copyright,
 * the privacy line and the machine-readable feeds.
 */
import { LANGS, HOME_SERVICES, firm, type Lang } from '@/config/site';
import { t, localePath } from '@/i18n/utils';
import { getServices, getIssues, serviceSlug, entryKey } from '@/lib/content';

interface Props { lang: Lang; alternates: Partial<Record<Lang, string>> }
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
const services = (await getServices(lang)).filter((s) => (HOME_SERVICES as readonly string[]).includes(entryKey(s)));
const socials = [
  ['Telegram', firm.social.telegram], ['LinkedIn', firm.social.linkedin], ['Facebook', firm.social.facebook],
  ['Instagram', firm.social.instagram], ['YouTube', firm.social.youtube],
].filter(([, url]) => url) as [string, string][];
const hasIssues = (await getIssues()).length > 0; // the link appears with the first issue
const sections = [
  { href: localePath(lang, 'about'), label: tr('nav.about') },
  { href: localePath(lang, 'team'), label: tr('nav.team') },
  { href: localePath(lang, 'blog'), label: tr('nav.blog') },
  ...(hasIssues ? [{ href: localePath(lang, 'issues'), label: tr('nav.issues') }] : []),
  { href: localePath(lang, 'documents'), label: tr('nav.documents') },
  { href: localePath(lang, 'contacts'), label: tr('nav.contacts') },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div>
        <a class="foot-brand" href={localePath(lang)} aria-label={`${firm.shortName} — ${tr('nav.home')}`}>
          <img src="/img/owls-white.svg" alt="" width="88" height="44" loading="lazy" />
          <span class="wordmark">{firm.shortName}</span>
        </a>
        <p class="foot-about">{firm.legalName[lang]}. {firm.registry[lang]}.</p>
      </div>
      <div>
        <h4>{tr('footer.firm')}</h4>
        <ul>{sections.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>{tr('nav.services')}</h4>
        <ul>
          {services.map((s) => <li><a href={localePath(lang, 'services', serviceSlug(s))}>{s.data.short ?? s.data.title}</a></li>)}
          <li><a href={localePath(lang, 'services')}>{tr('home.allServices')}</a></li>
        </ul>
      </div>
      <div>
        <h4>{tr('nav.contacts')}</h4>
        <ul>
          <li><a href={`mailto:${firm.email}`}>{firm.email}</a></li>
          <li><a href={firm.phoneHref}>{firm.phone}</a></li>
          <li><address>{firm.address[lang]}</address></li>
          {socials.length > 0 && (
            <li>{socials.map(([name, url], i) => <>{i > 0 && <span class="sep"> · </span>}<a href={url} rel="noopener me" target="_blank">{name}</a></>)}</li>
          )}
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {firm.foundedYear}–{year} {firm.shortName}. {tr('footer.copyright')}</span>
      <span>{tr('footer.privacy')}</span>
      <span>{LANGS.map((l, i) => <>{i > 0 ? ' · ' : ''}<a href={`/${l}/rss.xml`}>RSS {l.toUpperCase()}</a></>)} · <a href="/llms.txt">llms.txt</a></span>
    </div>
  </div>
</footer>
