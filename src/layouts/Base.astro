---
/**
 * Base layout: <head> with canonical, hreflang, Open Graph, feeds and JSON-LD; header, footer, rails.
 * Every page passes the languages it exists in (`alternates`) so hreflang is reciprocal and never points
 * at a missing translation.
 */
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/JsonLd.astro';
import { LANGS, LANG_TAG, DEFAULT_LANG, firm, type Lang } from '@/config/site';
import { t, switchLang } from '@/i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path (without origin) for each language this page exists in. Defaults to the same path in all languages. */
  alternates?: Partial<Record<Lang, string>>;
  type?: 'website' | 'article';
  image?: string;
  published?: Date;
  updated?: Date;
  jsonLd?: object | object[];
  /** Which top-level section is active, for aria-current in the navigation. */
  section?: 'services' | 'about' | 'team' | 'blog' | 'documents' | 'contacts' | 'search';
  noindex?: boolean;
  /** Extra <link rel="alternate"> entries: feeds, markdown twin. */
  links?: { rel: string; type: string; href: string; title?: string }[];
}
const { lang, title, description, type = 'website', image, published, updated, jsonLd, section, noindex = false, links = [] } = Astro.props;
const site = Astro.site ?? new URL('https://tri-s-audit.uz');
const path = Astro.url.pathname;
const canonical = new URL(path, site);
const alternates: Partial<Record<Lang, string>> = Astro.props.alternates ?? Object.fromEntries(LANGS.map((l) => [l, switchLang(path, l)]));
const ogImage = new URL(image ?? '/og/default.png', site);
const tr = t(lang);
const fullTitle = title.includes(firm.shortName) ? title : `${title} — ${firm.shortName}`;
// A build for the preview host sets NOINDEX=1 so the temporary hostname never enters the index.
const previewNoindex = import.meta.env.NOINDEX === '1';
---
<!doctype html>
<html lang={LANG_TAG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  {(noindex || previewNoindex) && <meta name="robots" content="noindex, nofollow" />}
  {Object.entries(alternates).map(([l, p]) => (
    <link rel="alternate" hreflang={LANG_TAG[l as Lang]} href={new URL(p!, site).href} />
  ))}
  {alternates[DEFAULT_LANG] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LANG]!, site).href} />}
  <link rel="alternate" type="application/rss+xml" title={`${firm.shortName} — ${tr('blog.rss')} (${lang})`} href={new URL(`/${lang}/rss.xml`, site).href} />
  {links.map((l) => <link rel={l.rel} type={l.type} href={l.href} title={l.title} />)}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={firm.shortName} />
  <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : lang === 'en' ? 'en_GB' : 'uz_UZ'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
  <meta name="generator" content={Astro.generator} />
  {jsonLd && <JsonLd data={jsonLd} />}
</head>
<body>
  <a class="skip" href="#main">{lang === 'ru' ? 'К содержимому' : lang === 'en' ? 'Skip to content' : 'Mazmunga oʻtish'}</a>
  <div class="rail" aria-hidden="true"></div>
  <Header lang={lang} section={section} alternates={alternates} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} alternates={alternates} />
  <div class="rail" aria-hidden="true"></div>
</body>
</html>
