---
/**
 * Home page in design v3: full-bleed hero with the firm name over the mountain photo, lead and four facts;
 * "Who we are"; the navy services panel with six cards; the numbered steps from pages/<lang>/home.md;
 * the leadership block on the band; three latest posts; the sky contact panel.
 */
import { Image, Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import { LANGS, HOME_SERVICES, firm, type Lang } from '@/config/site';
import { t, localePath } from '@/i18n/utils';
import { getPosts, getServices, getTeam, getPage, serviceSlug, entryKey } from '@/lib/content';
import { organization, website } from '@/lib/schema';
import heroPhoto from '@/assets/hero-mountains.jpg';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const [posts, services, team, home] = await Promise.all([getPosts(lang), getServices(lang), getTeam(lang), getPage(lang, 'home')]);
if (!home) throw new Error(`pages/${lang}/home.md is missing`);
const { Content: Steps } = await render(home);
const leader = team.find((m) => m.data.lead);
const LeaderBio = leader ? (await render(leader)).Content : null;
const homeServices = HOME_SERVICES.map((k) => services.find((s) => entryKey(s) === k)).filter((s) => s !== undefined);
const facts: [string, string][] = [
  [tr('fact.auditTitle'), tr('fact.audit')],
  [tr('fact.isaTitle'), tr('fact.isa')],
  [tr('fact.ifrsTitle'), tr('fact.ifrs')],
  [tr('fact.forensicTitle'), tr('fact.forensic')],
];
---
<Base lang={lang} title={home.data.title} description={home.data.description} jsonLd={[organization(lang), website(lang)]}>
  <section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true">
      <Picture src={heroPhoto} widths={[800, 1400, 2400]} sizes="100vw" formats={['webp']} fallbackFormat="jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="wrap">
      <div class="hero-top">
        <p class="eyebrow eyebrow-plain eyebrow-center">{tr('hero.eyebrow')}</p>
        <h1 class="hero-title">{firm.shortName}</h1>
      </div>
      <div class="hero-lower">
        <p class="hero-lead">{home.data.description}</p>
        <div class="facts">
          {facts.map(([title, text]) => <div><b>{title}</b><span>{text}</span></div>)}
        </div>
      </div>
      <span class="visually-hidden">{tr('hero.photoCredit')}</span>
    </div>
  </section>

  {home.data.about && (
    <section class="section" id="about">
      <div class="wrap cols-5-7">
        <div>
          <p class="eyebrow">{tr('nav.about')}</p>
          <h2>{home.data.about.title}</h2>
        </div>
        <div class="col-text about-text">
          {home.data.about.text.map((p) => <p>{p}</p>)}
          <a class="more" href={localePath(lang, 'about')}>{tr('home.aboutMore')} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  )}

  <section class="panel-navy" id="services">
    <div class="wrap">
      <div class="section-intro">
        <p class="eyebrow eyebrow-center">{tr('home.services')}</p>
        <h2>{tr('home.servicesTitle')}</h2>
        <p>{tr('home.servicesLead')}</p>
      </div>
      <div class="cards-3">
        {homeServices.map((s) => (
          <article class="card">
            <ServiceIcon name={entryKey(s)} />
            <h3><a href={localePath(lang, 'services', serviceSlug(s))}>{s.data.title}</a></h3>
            <p>{s.data.summary}</p>
          </article>
        ))}
      </div>
      <div class="center-row">
        <a class="btn-outline-light" href={localePath(lang, 'services')}>{services.length === 9 ? tr('home.allNineServices') : tr('home.allServices')} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap cols-4-8">
      <div class="how-intro">
        <p class="eyebrow">{tr('home.approach')}</p>
        <h2>{tr('home.how')}</h2>
        {home.data.howLead && <p>{home.data.howLead}</p>}
      </div>
      <div><Steps /></div>
    </div>
  </section>

  {leader && LeaderBio && (
    <section class="band" id="team">
      <div class="wrap cols-5-7 leader" style="align-items:center">
        <div>
          {leader.data.photo && <Image class="lead-photo" src={leader.data.photo} alt={leader.data.name} width={760} widths={[380, 760]} sizes="(max-width: 980px) 100vw, 380px" loading="lazy" />}
        </div>
        <div>
          <p class="eyebrow">{tr('home.team')}</p>
          <h2>{leader.data.name}</h2>
          <p class="role">{leader.data.role}</p>
          <div class="bio"><LeaderBio /></div>
          <a class="more" href={localePath(lang, 'team')}>{tr('home.allTeam')} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section" id="blog">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">{tr('home.blog')}</p>
            <h2>{tr('home.blogTitle')}</h2>
          </div>
          <a class="more" href={localePath(lang, 'blog')}>{tr('home.allPosts')} <span aria-hidden="true">→</span></a>
        </div>
        <div class="cards-3">{posts.slice(0, 3).map((p) => <PostCard post={p} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <section class="cta" id="contacts">
    <div class="wrap">
      <div class="cta-panel cols-2">
        <div>
          <h2>{tr('cta.discuss')}</h2>
          <p>{tr('cta.text')}</p>
        </div>
        <div class="cta-links">
          <a class="contact-link" href={`mailto:${firm.email}`}>{firm.email}</a>
          <a class="contact-link" href={firm.phoneHref}>{firm.phone}</a>
          <address>{firm.address[lang]}</address>
        </div>
      </div>
    </div>
  </section>
</Base>
