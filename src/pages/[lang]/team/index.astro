---
import Base from '@/layouts/Base.astro';
import Crumbs from '@/components/Crumbs.astro';
import { LANGS, type Lang } from '@/config/site';
import { t, localePath } from '@/i18n/utils';
import { getTeam, entryKey } from '@/lib/content';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const team = await getTeam(lang);
---
<Base lang={lang} title={tr('team.title')} description={tr('team.description')} section="team">
  <div class="wrap page-head">
    <Crumbs items={[{ name: tr('nav.home'), href: localePath(lang) }, { name: tr('team.title') }]} />
    <h1>{tr('team.title')}</h1>
    <p class="lead">{tr('team.description')}</p>
  </div>
  <div class="wrap section" style="padding-top:0">
    <div class="grid">
      {team.map((m) => (
        <article class="card">
          {m.data.photo ? <img class="photo" src={m.data.photo.src} alt="" width="72" height="72" loading="lazy" /> : <div class="avatar" aria-hidden="true">{m.data.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2)}</div>}
          <h2 style="font-size:clamp(1.1rem,6cqi,1.35rem);margin:0"><a href={localePath(lang, 'team', entryKey(m))} style="color:inherit;text-decoration:none">{m.data.name}</a></h2>
          <p class="role">{m.data.role}</p>
        </article>
      ))}
    </div>
  </div>
</Base>
