---
import Base from '@/layouts/Base.astro';
import Crumbs from '@/components/Crumbs.astro';
import { LANGS, type Lang } from '@/config/site';
import { t, localePath } from '@/i18n/utils';
import { getTeam, entryKey, initials } from '@/lib/content';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const team = await getTeam(lang);
const groups = [
  { title: tr('team.leadership'), members: team.filter((m) => m.data.lead) },
  { title: tr('team.title'), members: team.filter((m) => !m.data.lead) },
].filter((g) => g.members.length > 0);
---
<Base lang={lang} title={tr('team.title')} description={tr('team.description')} section="team">
  <div class="wrap page-head">
    <Crumbs items={[{ name: tr('nav.home'), href: localePath(lang) }, { name: tr('team.title') }]} />
    <h1>{tr('team.title')}</h1>
    <p class="lead">{tr('team.description')}</p>
  </div>
  {groups.map((g) => (
    <section class="wrap section" style="padding-top:0">
      <div class="section-head"><h2>{g.title}</h2></div>
      <div class="grid">
        {g.members.map((m) => (
          <article class="card">
            <div class="portrait">{m.data.photo ? <img src={m.data.photo.src} alt="" width={m.data.photo.width} height={m.data.photo.height} loading="lazy" /> : <span aria-hidden="true">{initials(m.data.name)}</span>}</div>
            <h3><a href={localePath(lang, 'team', entryKey(m))}>{m.data.name}</a></h3>
            <p class="role">{m.data.role}</p>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
