---
import Base from '@/layouts/Base.astro';
import Crumbs from '@/components/Crumbs.astro';
import { LANGS, type Lang } from '@/config/site';
import { t, localePath, formatDate } from '@/i18n/utils';
import { getIssues, getPosts } from '@/lib/content';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const issues = await getIssues();
const posts = await getPosts(lang);
---
<Base lang={lang} title={tr('issues.title')} description={tr('issues.description')} section="blog">
  <div class="wrap page-head">
    <Crumbs items={[{ name: tr('nav.home'), href: localePath(lang) }, { name: tr('blog.title'), href: localePath(lang, 'blog') }, { name: tr('issues.title') }]} />
    <h1>{tr('issues.title')}</h1>
    <p class="lead">{tr('issues.description')}</p>
  </div>
  <div class="wrap section" style="padding-top:0">
    <div class="grid">
      {issues.map((i) => {
        const n = posts.filter((p) => p.data.issue === i.data.number).length;
        return (
          <article class="card">
            <span class="std">{tr('blog.issue')} {i.data.number} · {formatDate(i.data.date, lang)}</span>
            <h2 style="font-size:clamp(1.1rem,6cqi,1.35rem);margin:0"><a href={localePath(lang, 'issues', String(i.data.number))} style="color:inherit;text-decoration:none">{i.data.title[lang]}</a></h2>
            <p>{i.data.summary[lang]}</p>
            <p class="note">{n} {lang === 'ru' ? 'публ.' : lang === 'en' ? 'posts' : 'maqola'}</p>
          </article>
        );
      })}
    </div>
  </div>
</Base>
