{
  // Cloudflare Workers with static assets: the whole site is served from dist/, no Worker code.
  // Workers Builds: build `npm run build`, deploy `npx wrangler deploy`. See docs/DEPLOY_ru.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tri-s-audit-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
