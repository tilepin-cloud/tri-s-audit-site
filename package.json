{
  "name": "tri-s-audit-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public website of the audit firm TRI-S-AUDIT (Tashkent): Astro, three languages, static output.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "new:post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.7",
    "pagefind": "^1.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
